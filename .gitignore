# Avhengigheter (installeres på nytt med `npm install` / `npm ci`)
node_modules/
proxy/node_modules/

# OS
.DS_Store

# ---------------------------------------------------------------------------
# HELSEDATA — holdes utenfor git fordi dette repoet er OFFENTLIG.
# ---------------------------------------------------------------------------
# Treningsdataene bor normalt i et separat PRIVAT repo, som miljøvariabelen
# GARMIN_DATA_DIR peker på (se lib/paths.js og «Public repo» i README).
# Linjene under er sikkerhetsnettet den dagen variabelen IKKE er satt: da
# faller skriptene tilbake på ./data her, og da skal ingenting av det havne i
# git. Dataene inneholder søvn, HRV, hvilepuls, vekt, kroppsfett og GPS-spor
# for hver eneste tur — altså hvor du bor.
#
# Fjern aldri disse linjene. Sync-workflowen som committer data ligger i det
# private data-repoet, ikke her.
data/
dashboard.html

# Treningsdagbok / analyser skrevet av deg eller en AI-assistent. Fritekst om
# egen helse og form — hører ikke hjemme i et offentlig repo.
dagbok/

# Ruter fra finn-loype.js/finn-bakke.js. Røper hvor du løper, altså som regel
# hvor du bor.
loype.json
bakke.json

# Garmin-tokens skal ALDRI committes — de ligger uansett utenfor denne mappa i
# ~/.garmin-tokens, men holder igjen her i tilfelle noen kopierer dem hit ved
# et uhell. Et token gir full SKRIVETILGANG til Garmin-kontoen.
.garmin-tokens/
*.token.json
.env
.env.*
!.env.example

# Lokale AI-assistent-innstillinger og cache — ikke del av prosjektet.
# Unntak: .claude/skills/ er delte prosjekt-prosedyrer og SKAL committes,
# ellers finnes de ikke i skyøkter.
.claude/*
!.claude/skills/
